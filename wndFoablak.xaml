<Window x:Class="WPF_EFC_CF_Konyvtar.wndFőablak"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WPF_EFC_CF_Konyvtar"
        Title="Könyvtár – szerzők és könyvek" Height="520" Width="820"
        WindowStartupLocation="CenterScreen"
        Closed="wndFőablak_Closed">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem x:Name="miFájl" Header="_Fájl">
                <MenuItem x:Name="miKilépés" Header="_Kilépés" Click="miKilépés_Click" />
            </MenuItem>
            <MenuItem x:Name="miSzerzők" Header="_Szerzők">
                <MenuItem x:Name="miSzerzőLista" Header="_Listázás" Click="miSzerzőLista_Click" />
                <Separator />
                <MenuItem x:Name="miSzerzőÚj" Header="Ú_j szerző..." Click="miSzerzőÚj_Click" />
                <MenuItem x:Name="miSzerzőMódosítás" Header="_Módosítás..." Click="miSzerzőMódosítás_Click" />
                <MenuItem x:Name="miSzerzőTörlés" Header="_Törlés" Click="miSzerzőTörlés_Click" />
            </MenuItem>
            <MenuItem x:Name="miKönyvek" Header="_Könyvek">
                <MenuItem x:Name="miKönyvLista" Header="_Listázás" Click="miKönyvLista_Click" />
                <Separator />
                <MenuItem x:Name="miKönyvÚj" Header="Ú_j könyv..." Click="miKönyvÚj_Click" />
                <MenuItem x:Name="miKönyvMódosítás" Header="_Módosítás..." Click="miKönyvMódosítás_Click" />
                <MenuItem x:Name="miKönyvTörlés" Header="_Törlés" Click="miKönyvTörlés_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="tblÁllapot" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="tblFejléc" Grid.Row="0" FontSize="18" FontWeight="SemiBold"
                       Margin="0,0,0,10" />

            <!-- Szerzők listája -->
            <DataGrid x:Name="dgSzerzők" Grid.Row="1" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                      HeadersVisibility="Column" MouseDoubleClick="dgSzerzők_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Azonosító" Binding="{Binding Id}" Width="80" />
                    <DataGridTextColumn Header="Név" Binding="{Binding Név}" Width="*" />
                    <DataGridTextColumn Header="Születési év" Binding="{Binding SzületésiÉv}" Width="100" />
                    <DataGridTextColumn Header="Nemzetiség" Binding="{Binding Nemzetiség}" Width="120" />
                    <DataGridTextColumn Header="Könyvek száma" Binding="{Binding Könyvek.Count}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Könyvek listája -->
            <DataGrid x:Name="dgKönyvek" Grid.Row="1" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                      HeadersVisibility="Column" Visibility="Collapsed"
                      MouseDoubleClick="dgKönyvek_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Azonosító" Binding="{Binding Id}" Width="80" />
                    <DataGridTextColumn Header="Cím" Binding="{Binding Cím}" Width="*" />
                    <DataGridTextColumn Header="Szerző" Binding="{Binding Szerző.Név}" Width="160" />
                    <DataGridTextColumn Header="Kiadás éve" Binding="{Binding KiadásÉve}" Width="90" />
                    <DataGridTextColumn Header="Oldalszám" Binding="{Binding Oldalszám}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Az adatbevitelre / módosításra szolgáló UserControl-ok (egy-egy példány, újrahasznosítva) -->
            <local:ucSzerző x:Name="ucSzerzőŰrlap" Grid.Row="1" Visibility="Collapsed" />
            <local:ucKönyv x:Name="ucKönyvŰrlap" Grid.Row="1" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
